<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Motivo_Rechazo_Obligatorio</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
      ISPICKVAL(Estado__c, &apos;Rechazada&apos;),
			 		ISBLANK(Motivo_Rechazo__c) 
	)</errorConditionFormula>
    <errorDisplayField>Motivo_Rechazo__c</errorDisplayField>
    <errorMessage>Debe ingresar el motivo de rechazo cuando la solicitud esté Rechazada</errorMessage>
</ValidationRule>
